
#include <stdio.h>

int main() {
    int study[7] = {0};  // 요일별 공부 시간 저장
    int choice;
    int day;
    int minutes;
    int total;
    int count;
    int running = 1;

    while (running == 1) {

    menu_input:
        printf("\n===== 공부 시간 관리 프로그램 =====\n");
        printf("1. 공부 시간 기록하기\n");
        printf("2. 공부 시간 확인하기\n");
        printf("3. 공부 시간 분석하기\n");
        printf("4. 집중 회차 확인하기\n");
        printf("0. 프로그램 종료하기\n");
        printf("메뉴 선택: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                printf("요일 입력 (1:월 ~ 7:일): ");
                scanf("%d", &day);

                do {
                    if (day < 1 || day > 7) {
                        printf("잘못된 요일입니다. 다시 입력: ");
                        scanf("%d", &day);
                    }
                } while (day < 1 || day > 7);

                printf("공부 시간(분) 입력: ");
                scanf("%d", &minutes);

                while (minutes <= 0) {
                    printf("0보다 큰 시간을 입력하세요: ");
                    scanf("%d", &minutes);
                }

                study[day - 1] += minutes;

                printf("공부 시간이 기록되었습니다!\n");
                break;

            case 2:
                printf("\n===== 요일별 공부 시간 =====\n");

                for (int i = 0; i < 7; i++) {

                    if (study[i] == 0) {
                        continue;
                    }

                    printf("%d요일: %d분\n",
                           i + 1, study[i]);
                }
                break;

            case 3:
                total = 0;
                count = 0;

                printf("\n===== 공부 시간 분석 =====\n");

                for (int i = 0; i < 7; i++) {
                    total += study[i];

                    if (study[i] > 0) {
                        count++;
                    }
                }

                printf("총 공부 시간: %d분\n", total);

                if (count > 0) {
                    printf("평균 공부 시간: %.1f분\n",
                           (double)total / count);
                }
                else {
                    printf("아직 기록된 공부 시간이 없습니다.\n");
                }

                printf("\n===== 공부 시간 계단식 출력 =====\n");

                for (int i = 0; i < 7; i++) {
                    printf("%d요일 ", i + 1);

                    int blocks = study[i] / 30;

                    if (blocks > 10) {
                        blocks = 10;
                    }

                    for (int j = 0; j < blocks; j++) {
                        printf("*");
                    }

                    printf("\n");
                }
                break;

            case 4:
                printf("\n===== 집중 회차 확인 =====\n");

                for (int i = 1; i <= 15; i++) {

                    if (i % 3 == 0 && i % 5 == 0) {
                        printf("FizzBuzz\n");
                    }
                    else if (i % 3 == 0) {
                        printf("Fizz\n");
                    }
                    else if (i % 5 == 0) {
                        printf("Buzz\n");
                    }
                    else {
                        printf("%d\n", i);
                    }
                }
                break;

            case 0:
                printf("프로그램을 종료합니다.\n");
                running = 0;
                break;

            default:
                printf("잘못된 메뉴입니다. 다시 선택하세요.\n");
                goto menu_input;
        }
    }

    return 0;
}
