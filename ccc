#include <stdio.h>

#define DAYS 7
#define DAILY_BUDGET 15000

// 일주일 지출 입력
void inputExpenses(int *expenses)
{
    for (int i = 0; i < DAYS; i++) {
        do {
            printf("%d일 차 지출 금액: ", i + 1);
            scanf("%d", expenses + i);

            if (*(expenses + i) < 0)
                printf("지출은 음수일 수 없습니다.\n");

        } while (*(expenses + i) < 0);
    }
}

// 전체 지출 내역 출력
void showExpenses(const int *expenses)
{
    printf("\n[일주일 지출 내역]\n");

    for (int i = 0; i < DAYS; i++) {
        printf("%d일 차: %d원", i + 1, *(expenses + i));

        if (*(expenses + i) > DAILY_BUDGET)
            printf(" [예산 초과]");

        printf("\n");
    }
}

// 특정 날짜 지출 수정
void editExpense(int *expenses)
{
    int day, amount;

    printf("수정할 날짜(1~7): ");
    scanf("%d", &day);

    if (day < 1 || day > DAYS) {
        printf("잘못된 날짜입니다.\n");
        return;
    }

    do {
        printf("새로운 지출 금액: ");
        scanf("%d", &amount);

        if (amount < 0)
            printf("음수는 입력할 수 없습니다.\n");

    } while (amount < 0);

    // 포인터를 이용해 원래 배열의 값 수정
    *(expenses + day - 1) = amount;

    printf("%d일 차 지출이 수정되었습니다.\n", day);
}

// 주요 소비 통계 계산
void analyzeExpenses(const int *expenses, int count,
                     int *total, int *maxDay,
                     int *overBudgetCount)
{
    *total = 0;
    *maxDay = 0;
    *overBudgetCount = 0;

    for (int i = 0; i < count; i++) {
        *total += *(expenses + i);

        if (*(expenses + i) > *(expenses + *maxDay))
            *maxDay = i;

        if (*(expenses + i) > DAILY_BUDGET)
            (*overBudgetCount)++;
    }
}

// 분석 결과 출력
void showReport(const int *expenses)
{
    int total, maxDay, overBudgetCount;

    analyzeExpenses(expenses, DAYS,
                    &total, &maxDay, &overBudgetCount);

    printf("\n[주간 소비 분석]\n");
    printf("총지출: %d원\n", total);
    printf("하루 평균: %.0f원\n", (double)total / DAYS);
    printf("최대 지출: %d일 차 (%d원)\n",
           maxDay + 1, *(expenses + maxDay));
    printf("예산 초과 날짜: %d일\n", overBudgetCount);
}

// 예산 초과 날짜만 출력
void showOverBudget(const int *expenses)
{
    int found = 0;

    printf("\n[예산 초과 내역]\n");

    for (int i = 0; i < DAYS; i++) {
        if (*(expenses + i) > DAILY_BUDGET) {
            printf("%d일 차: %d원 (초과 %d원)\n",
                   i + 1, *(expenses + i),
                   *(expenses + i) - DAILY_BUDGET);
            found = 1;
        }
    }

    if (!found)
        printf("예산을 초과한 날이 없습니다.\n");
}

int main(void)
{
    int expenses[DAYS];
    int menu;

    printf("===== 개인 지출 관리 시스템 =====\n");
    printf("하루 기준 예산: %d원\n\n", DAILY_BUDGET);

    inputExpenses(expenses);

    do {
        printf("\n===== 메뉴 =====\n");
        printf("1. 지출 내역 조회\n");
        printf("2. 지출 금액 수정\n");
        printf("3. 주간 소비 분석\n");
        printf("4. 예산 초과 내역\n");
        printf("5. 종료\n");
        printf("선택: ");

        if (scanf("%d", &menu) != 1) {
            printf("숫자를 입력해 주세요.\n");
            return 1;
        }

        switch (menu) {
        case 1:
            showExpenses(expenses);
            break;

        case 2:
            editExpense(expenses);
            break;

        case 3:
            showReport(expenses);
            break;

        case 4:
            showOverBudget(expenses);
            break;

        case 5:
            printf("프로그램을 종료합니다.\n");
            break;

        default:
            printf("1~5 중에서 선택해 주세요.\n");
        }

    } while (menu != 5);

    return 0;
}





