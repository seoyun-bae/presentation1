
#include <stdio.h>

// 결제 방식에 따라 다른 정보를 저장하는 공용체
union PaymentInfo {
    char cardNumber[5];  // 카드 뒷자리 4개
    int receiptNumber;   // 현금영수증 번호
};

// 하나의 지출 정보를 저장하는 구조체
struct Expense {
    char name[30];       // 지출 항목
    int amount;          // 지출 금액
    int method;          // 1: 카드, 2: 현금
    union PaymentInfo payment;
};

int main() {

    // 구조체 배열을 선언하고 지출 정보 초기화
    struct Expense expenses[3] = {
        {"점심식사", 9000, 1, {"1234"}},
        {"카페", 5000, 2, {.receiptNumber = 1001}},
        {"교통비", 1500, 1, {"5678"}}
    };

    int size = 3;
    int total = 0;
    double average;
    int maxIndex = 0;

    printf("===== 하루 지출 내역 =====\n");

    // 구조체 포인터를 이용하여 지출 정보 출력
    for (int i = 0; i < size; i++) {

        struct Expense *p = &expenses[i];

        printf("항목: %s\n", p->name);
        printf("금액: %d원\n", p->amount);

        if (p->method == 1) {
            printf("결제 방식: 카드\n");
            printf("카드 뒷자리: %s\n",
                   p->payment.cardNumber);
        }
        else {
            printf("결제 방식: 현금\n");
            printf("영수증 번호: %d\n",
                   p->payment.receiptNumber);
        }

        printf("----------------------\n");
    }

    // 전체 지출 금액 계산
    for (int i = 0; i < size; i++) {
        total += expenses[i].amount;
    }

    // 평균 지출 금액 계산
    average = (double)total / size;

    // 가장 많은 지출 항목 찾기
    for (int i = 1; i < size; i++) {
        if (expenses[i].amount >
            expenses[maxIndex].amount) {

            maxIndex = i;
        }
    }

    // 최종 분석 결과 출력
    printf("\n===== 지출 분석 결과 =====\n");
    printf("총 지출 금액: %d원\n", total);
    printf("평균 지출 금액: %.1f원\n", average);
    printf("최대 지출 항목: %s\n",
           expenses[maxIndex].name);
    printf("최대 지출 금액: %d원\n",
           expenses[maxIndex].amount);

    return 0;
}
